# Installed-project exclusions. Shared memory and events belong in project Git.
# The public template has additional exclusions in its root .gitignore.

# Environment and credential files. Keep only the intentionally data-free example.
.env
.env.*
.envrc
!.env.example

# Session and runtime state
SESSION_CONTEXT.local.md
SESSION_CONTEXT.md.backup
SESSION_CONTEXT_BACKUP_*.md
.hub_enabled
.hub_disabled
local/
work-items/
archive/
hub/

# Runtime control and authority records
control/EXECUTOR_REGISTRY.json
control/EXTERNAL_SYNC_POLICY.json

# Project memory, events, and the install manifest are intentionally NOT ignored.
# The manifest lets a fresh clone tell stock template files from edited ones.

# Generated caches
__pycache__/
*.py[cod]
