{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/exocortex/schemas/orchestration.schema.json",
  "title": "Exocortex public-v2 work item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "revision",
    "lifecycle",
    "designated_base",
    "lane",
    "acceptance_criteria",
    "transitions",
    "checkpoints",
    "handoffs",
    "idempotency"
  ],
  "properties": {
    "schema_version": { "const": "public-v2" },
    "kind": { "const": "delivery_work_item" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "bug",
        "maintenance",
        "security_privacy",
        "migration",
        "documentation_process",
        "retrospective_improvement"
      ]
    },
    "revision": { "type": "integer", "minimum": 0 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attempt", "blocked"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "attempt": { "type": "integer", "minimum": 0 },
        "blocked": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "since"],
              "properties": {
                "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "since": { "$ref": "#/$defs/timestamp" }
              }
            }
          ]
        }
      }
    },
    "designated_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "source"],
      "properties": {
        "sha": { "$ref": "#/$defs/sha256_or_git" },
        "ref": { "type": ["string", "null"], "maxLength": 300 },
        "source": {
          "type": "string",
          "enum": ["approved_work_item", "branch_policy", "release_record"]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "reservation"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "writer", "surface_id", "executor_id", "lease_expires_at", "version"],
          "properties": {
            "status": { "type": "string", "enum": ["none", "active", "released", "expired"] },
            "writer": { "type": ["string", "null"], "maxLength": 200 },
            "surface_id": { "type": ["string", "null"], "maxLength": 200 },
            "executor_id": { "type": ["string", "null"], "maxLength": 200 },
            "lease_expires_at": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }]
            },
            "version": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "passed", "failed", "blocked"] },
          "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "enum": ["passed", "failed", "blocked"] } },
              "required": ["status"]
            },
            "then": {
              "required": ["evidence"],
              "properties": { "evidence": { "minItems": 1 } }
            }
          }
        ]
      }
    },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "handoffs": { "type": "array", "items": { "$ref": "#/$defs/handoff" } },
    "idempotency": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "operation", "result_id", "accepted_at"],
        "properties": {
          "request_id": { "$ref": "#/$defs/id" },
          "operation": { "type": "string", "minLength": 1, "maxLength": 120 },
          "result_id": { "$ref": "#/$defs/id" },
          "accepted_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "local_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_path",
        "envelope_digest",
        "registry_digest",
        "worktree_identity_digest",
        "seal",
        "completion"
      ],
      "properties": {
        "envelope_path": { "$ref": "#/$defs/relative_path" },
        "envelope_digest": { "$ref": "#/$defs/sha256" },
        "registry_digest": { "$ref": "#/$defs/sha256" },
        "worktree_identity_digest": { "$ref": "#/$defs/sha256" },
        "seal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["request_id", "sealed_at", "changed_paths", "path_set_digest", "candidate_digest"],
              "properties": {
                "request_id": { "$ref": "#/$defs/id" },
                "sealed_at": { "$ref": "#/$defs/timestamp" },
                "changed_paths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/relative_path" }
                },
                "path_set_digest": { "$ref": "#/$defs/sha256" },
                "candidate_digest": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "completion": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["request_id", "completed_at", "local_state", "event_path", "body_digest", "event_digest"],
              "properties": {
                "request_id": { "$ref": "#/$defs/id" },
                "completed_at": { "$ref": "#/$defs/timestamp" },
                "local_state": { "const": "complete" },
                "event_path": { "$ref": "#/$defs/relative_path" },
                "body_digest": { "$ref": "#/$defs/sha256" },
                "event_digest": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    },
    "retrospectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observations", "proposed_work_item", "authority"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "observations": { "type": "array", "items": { "type": "string" } },
          "proposed_work_item": { "type": "object" },
          "authority": { "const": "proposal_only" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["local_delivery"] },
      "then": {
        "properties": {
          "transitions": {
            "items": {
              "allOf": [
                {
                  "required": ["capability_path", "capability_digest", "intent_digest"]
                },
                {
                  "if": { "properties": { "to": { "const": "human_uat" } }, "required": ["to"] },
                  "then": {
                    "required": ["human_uat_attestor"],
                    "properties": { "evidence": { "minItems": 1 } }
                  },
                  "else": { "not": { "required": ["human_uat_attestor"] } }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "transitions": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["capability_path"] },
                  { "required": ["capability_digest"] },
                  { "required": ["intent_digest"] },
                  { "required": ["human_uat_attestor"] }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "sha256_or_git": { "type": "string", "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": {
      "type": "string",
      "enum": [
        "captured",
        "triaged",
        "refined",
        "ready",
        "reserved",
        "developing",
        "developer_verified",
        "independent_review",
        "qa_sit",
        "uat_ready",
        "human_uat",
        "release_ready",
        "awaiting_release",
        "deployment_approved",
        "deployed",
        "hypercare",
        "done"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request_id", "operation", "from", "to", "accepted_at", "capability_id", "checkpoint_eligible", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "request_id": { "$ref": "#/$defs/id" },
        "operation": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/state" },
        "to": { "$ref": "#/$defs/state" },
        "accepted_at": { "$ref": "#/$defs/timestamp" },
        "capability_id": { "$ref": "#/$defs/id" },
        "checkpoint_eligible": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reviewer_surface_id": { "$ref": "#/$defs/id" },
        "reviewer_executor_id": { "$ref": "#/$defs/id" },
        "review_evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "review_transition_id": { "$ref": "#/$defs/id" },
        "human_uat_attestor": { "type": "string", "minLength": 1 },
        "capability_path": { "$ref": "#/$defs/relative_path" },
        "capability_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "intent_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "oneOf": [
            { "properties": { "from": { "const": "captured" }, "to": { "const": "triaged" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "triaged" }, "to": { "const": "refined" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "refined" }, "to": { "const": "ready" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "ready" }, "to": { "const": "reserved" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "reserved" }, "to": { "const": "developing" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "developing" }, "to": { "const": "developer_verified" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "developer_verified" }, "to": { "const": "independent_review" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "independent_review" }, "to": { "const": "qa_sit" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "qa_sit" }, "to": { "const": "uat_ready" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "uat_ready" }, "to": { "const": "human_uat" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "human_uat" }, "to": { "const": "release_ready" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "release_ready" }, "to": { "const": "awaiting_release" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "awaiting_release" }, "to": { "const": "deployment_approved" }, "checkpoint_eligible": { "const": false } } },
            { "properties": { "from": { "const": "deployment_approved" }, "to": { "const": "deployed" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "deployed" }, "to": { "const": "hypercare" }, "checkpoint_eligible": { "const": true } } },
            { "properties": { "from": { "const": "hypercare" }, "to": { "const": "done" }, "checkpoint_eligible": { "const": true } } }
          ]
        },
        {
          "if": { "properties": { "to": { "const": "independent_review" } }, "required": ["to"] },
          "then": { "required": ["reviewer_surface_id", "reviewer_executor_id", "review_evidence_hash"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["reviewer_surface_id"] },
                { "required": ["reviewer_executor_id"] },
                { "required": ["review_evidence_hash"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "to": { "const": "qa_sit" } }, "required": ["to"] },
          "then": { "required": ["review_transition_id"] },
          "else": { "not": { "required": ["review_transition_id"] } }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transition_id", "request_id", "state", "created_at", "local_only"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "transition_id": { "$ref": "#/$defs/id" },
        "request_id": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/state" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "local_only": { "const": true }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request_id", "created_at", "base_sha", "candidate_sha", "state", "writer_status", "capability_id", "capability_digest", "registry_digest", "evidence_hashes", "closed_gates", "first_verification", "local_only"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "request_id": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "base_sha": { "$ref": "#/$defs/sha256_or_git" },
        "candidate_sha": { "$ref": "#/$defs/sha256_or_git" },
        "state": { "$ref": "#/$defs/state" },
        "writer_status": { "type": "string", "enum": ["active", "released", "expired", "none"] },
        "capability_id": { "$ref": "#/$defs/id" },
        "capability_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "registry_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_hashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "closed_gates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "first_verification": { "type": "string", "minLength": 1 },
        "local_only": { "const": true }
      }
    }
  }
}
