{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/exocortex/model-observation.schema.json",
  "title": "Exocortex normalized official-source model observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "observed_at",
    "source_registry_digest",
    "source_observations"
  ],
  "properties": {
    "schema_version": {
      "const": "public-v2"
    },
    "kind": {
      "const": "model_observation"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "source_registry_digest": {
      "$ref": "#/$defs/sha256"
    },
    "source_observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "scope",
          "complete_listing",
          "retrieved_at",
          "content_sha256",
          "models"
        ],
        "properties": {
          "source_id": {
            "$ref": "#/$defs/id"
          },
          "scope": {
            "const": "registered_source"
          },
          "complete_listing": {
            "type": "boolean"
          },
          "retrieved_at": {
            "$ref": "#/$defs/timestamp"
          },
          "content_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "models": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 3,
              "required": [
                "id",
                "provider_id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "provider_id": {
                  "$ref": "#/$defs/id"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "lifecycle": {
                  "enum": [
                    "active",
                    "preview",
                    "deprecated",
                    "retired",
                    "unknown"
                  ]
                },
                "input_microusd_per_mtok": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "output_microusd_per_mtok": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
