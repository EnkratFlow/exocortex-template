{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/exocortex/model-source-registry.schema.json",
  "title": "Exocortex official model source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "registry_version",
    "observed_at",
    "expires_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "public-v2"
    },
    "kind": {
      "const": "model_source_registry"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider_id",
          "url",
          "roles",
          "retrieved_at",
          "content_sha256",
          "refresh_interval_hours"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "provider_id": {
            "$ref": "#/$defs/id"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^?#]+$",
            "maxLength": 500
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "models",
                "pricing",
                "lifecycle",
                "availability"
              ]
            }
          },
          "retrieved_at": {
            "$ref": "#/$defs/timestamp"
          },
          "content_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "refresh_interval_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
