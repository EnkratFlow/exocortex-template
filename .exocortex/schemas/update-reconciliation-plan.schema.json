{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/exocortex/update-reconciliation-plan.schema.json",
  "title": "Exocortex exact target update reconciliation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_id",
    "work_item",
    "candidate_digest",
    "target_surface_digest",
    "created_at",
    "standard_update_changed_paths",
    "standard_update_changed_paths_digest",
    "entries",
    "effect_paths",
    "effect_paths_digest",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "public-v2"
    },
    "kind": {
      "const": "update_reconciliation_plan"
    },
    "plan_id": {
      "$ref": "#/$defs/id"
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidate_digest": {
      "$ref": "#/$defs/sha256"
    },
    "target_surface_digest": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "standard_update_changed_paths": {
      "$ref": "#/$defs/path_array"
    },
    "standard_update_changed_paths_digest": {
      "$ref": "#/$defs/sha256"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "current_sha256",
          "candidate_sha256",
          "object_path",
          "object_sha256",
          "expected_mode"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "action": {
            "enum": [
              "adopt_candidate",
              "use_reviewed_object",
              "retire_target"
            ]
          },
          "current_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "candidate_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "object_path": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/relative_path"
              }
            ]
          },
          "object_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "expected_mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/file_mode"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "retire_target"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "properties": {
                "expected_mode": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "expected_mode": {
                  "$ref": "#/$defs/file_mode"
                }
              }
            }
          }
        ]
      }
    },
    "effect_paths": {
      "$ref": "#/$defs/path_array"
    },
    "effect_paths_digest": {
      "$ref": "#/$defs/sha256"
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "push",
        "deployment",
        "external_sync",
        "template_promotion"
      ],
      "properties": {
        "commit": {
          "const": false
        },
        "push": {
          "const": false
        },
        "deployment": {
          "const": false
        },
        "external_sync": {
          "const": false
        },
        "template_promotion": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file_mode": {
      "type": "string",
      "enum": [
        "0644",
        "0755"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$))"
      }
    },
    "path_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_path"
      }
    }
  }
}
