# Exocortex API Keys
# ------------------
# Optional — the system works without these, but AI memory features
# (RIGHT NOW, SHORT-TERM, LONG-TERM, SUBCONSCIOUS, /drill) require at least one.
# Without a key, memory commands show raw event timestamps only.

# OpenAI (primary) — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (fallback) — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model Configuration (optional — defaults shown)
# ------------------------------------------------
# OpenAI models: gpt-4o-mini (fast/cheap), gpt-4o (smarter), o1-mini, o3-mini
OPENAI_MODEL=gpt-4o-mini

# Anthropic models: claude-3-haiku-20240307 (fast/cheap), claude-3-5-sonnet-20241022 (smarter)
ANTHROPIC_MODEL=claude-3-haiku-20240307
