# API Keys for LLM-powered memory analysis
# Copy this file to .env and add your keys
# This file is gitignored — your keys stay local
#
# cp .env.example .env
# Then edit .env with your actual keys

# OpenAI (preferred - faster and cheaper for memory analysis)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (fallback if OpenAI unavailable)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
